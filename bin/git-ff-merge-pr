#!/usr/bin/env ruby
# git-ff-merge-pr

# 20261018
# 0.0.0

# Usage:
# 1. On a branch with an open pull request:
#  `git ff-merge-pr`
#   It fast-forwards the pull request's base branch to the branch and pushes it, and GitHub then marks the pull request merged.

# Notes:
# 1. Fast-forward only, so that the commits on the base branch are the ones which were pushed, signatures and all. Where it cannot fast-forward, it stops without pushing.
# 2. Requires gh, signed in.
# 3. Assumes that the remote is called origin.

gem 'git.rb'

require 'Git/Branch'
require 'Git/Remote'
require 'json'

def validate_origin
  abort "There is no remote called origin." unless Git::Remote.exist?('origin')
end

def run!(command)
  system(command) || exit(1)
end

def branch
  @branch ||= Git::Branch.current.name
end

def pull_request
  @pull_request ||= (
    output = `gh pr view #{branch} --json state,baseRefName,headRefOid,url`
    JSON.parse(output) if $?.success?
  )
end

def base_branch
  pull_request['baseRefName']
end

def branch_commit
  `git rev-parse #{branch}`.strip
end

def open_pull_request?
  pull_request && pull_request['state'] == 'OPEN'
end

def pushed?
  pull_request['headRefOid'] == branch_commit
end

def fast_forwardable?
  system("git merge-base --is-ancestor origin/#{base_branch} #{branch}")
end

def validate_pull_request
  abort "#{branch} has no open pull request." unless open_pull_request?
  abort "#{branch} is not the pull request's head. Push it, then run `git ff-merge-pr` again." unless pushed?
  abort <<~MESSAGE unless fast_forwardable?
    #{base_branch} has moved on since #{branch} was cut. Rebase it and push it, then run `git ff-merge-pr` again:
      git rebase origin/#{base_branch}
      git push --force-with-lease
  MESSAGE
end

def fast_forward_base_branch
  system("git merge --ff-only #{branch}") || abort(<<~MESSAGE)
    #{base_branch} has commits of its own, so it cannot be fast-forwarded to #{branch}. Move them to a branch and put #{base_branch} back:
      git branch <new-branch>
      git reset --hard origin/#{base_branch}
  MESSAGE
end

def main
  validate_origin
  run!('git fetch origin')
  validate_pull_request
  run!("git checkout #{base_branch}")
  fast_forward_base_branch
  run!("git push origin #{base_branch}")
  puts "Merged #{pull_request['url']}"
end

main
