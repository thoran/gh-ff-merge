#!/usr/bin/env ruby
# gh-ff-merge

# 20261021
# 0.2.0

# Usage:
# 1. On a branch with an open pull request:
#  `gh ff-merge`
#   It fast-forwards the pull request's base branch to the branch and pushes it, and GitHub then marks the pull request merged.
# 2. To check the base branch as well, stopping where it isn't the pull request's:
#  `gh ff-merge <base-branch>`
# 3. To delete the branch as well, locally and on origin, once merged:
#  `gh ff-merge -d`

# Notes:
# 1. Fast-forward only, so that the commits on the base branch are the ones which were pushed, signatures and all. Where it cannot fast-forward, it stops without pushing.
# 2. Requires gh, signed in.
# 3. Assumes that the remote is called origin.

gem 'git.rb'
gem 'switches.rb'

require 'Git/Remote'
require 'json'
require 'switches.rb'

MERGED_CHECKS = 10
MERGED_CHECK_INTERVAL = 2

def usage
  puts "gh-ff-merge - Merge a branch's open pull request by fast-forwarding its base branch and pushing it."
  puts
  puts "Usage: gh ff-merge [options] [<base-branch>]"
  puts
  puts "The base branch is the pull request's. Where one is given and it isn't the pull request's, it stops."
  puts
  puts "Options:"
  puts "  -d, --delete-branch  Delete the branch, locally and on origin, once merged"
  puts "  -h, --help           Show this help"
end

def switches
  @switches ||= Switches.new do |s|
    s.boolean(:d, :delete_branch){'Delete the branch, locally and on origin, once merged'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

def validate_args
  if ARGV.length > 1
    usage
    exit 1
  end
end

def validate_origin
  abort "There is no remote called origin." unless Git::Remote.exist?('origin')
end

def run!(command)
  system(command) || exit(1)
end

def branch
  @branch ||= `git symbolic-ref --quiet --short HEAD`.strip
end

def validate_branch
  abort "Not on a branch. Check out the branch to merge." if branch.empty?
end

def pull_request
  @pull_request ||= (
    output = `gh pr view #{branch} --json state,baseRefName,headRefOid,url`
    JSON.parse(output) if $?.success?
  )
end

def base_branch
  pull_request['baseRefName']
end

def named_base_branch
  ARGV.first
end

def branch_commit
  `git rev-parse #{branch}`.strip
end

def open_pull_request?
  pull_request && pull_request['state'] == 'OPEN'
end

def named_base_branch_matches?
  named_base_branch.nil? || named_base_branch == base_branch
end

def pushed?
  pull_request['headRefOid'] == branch_commit
end

def fast_forwardable?
  system("git merge-base --is-ancestor origin/#{base_branch} #{branch}")
end

def validate_pull_request
  abort "#{branch} has no open pull request." unless open_pull_request?
  abort "#{named_base_branch} isn't the base branch of #{pull_request['url']}, which is #{base_branch}." unless named_base_branch_matches?
  abort "#{branch} is not the pull request's head. Push it, then run `gh ff-merge` again." unless pushed?
  abort <<~MESSAGE unless fast_forwardable?
    #{base_branch} has moved on since #{branch} was cut. Rebase it and push it, then run `gh ff-merge` again:
      git rebase origin/#{base_branch}
      git push --force-with-lease
  MESSAGE
end

def fast_forward_base_branch
  system("git merge --ff-only #{branch}") || abort(<<~MESSAGE)
    #{base_branch} has commits of its own, so it cannot be fast-forwarded to #{branch}. Move them to a branch and put #{base_branch} back:
      git branch <new-branch>
      git reset --hard origin/#{base_branch}
  MESSAGE
end

def on_base_branch?
  system("git fetch origin #{base_branch}") &&
    system("git merge-base --is-ancestor #{branch_commit} origin/#{base_branch}")
end

def validate_on_base_branch
  abort "origin/#{base_branch} doesn't hold #{branch}, so #{branch} is kept." unless on_base_branch?
end

def pull_request_state
  `gh pr view #{pull_request['url']} --json state --jq .state`.strip
end

def merged?
  MERGED_CHECKS.times.any? do |check|
    sleep MERGED_CHECK_INTERVAL unless check.zero?
    pull_request_state == 'MERGED'
  end
end

def validate_merged
  abort <<~MESSAGE unless merged?
    GitHub hasn't yet marked #{pull_request['url']} merged, so #{branch} is kept. Once it has:
      git push origin --delete #{branch}
      git branch -d #{branch}
  MESSAGE
end

def remote_branch_exist?
  system("git ls-remote --exit-code --heads origin refs/heads/#{branch}", out: File::NULL)
end

def delete_remote_branch
  run!("git push origin --delete #{branch}") if remote_branch_exist?
end

def delete_local_branch
  run!("git branch -d #{branch}")
end

def delete_branch
  validate_on_base_branch
  validate_merged
  delete_remote_branch
  delete_local_branch
end

def main
  switches
  validate_args
  validate_origin
  validate_branch
  run!('git fetch origin')
  validate_pull_request
  run!("git checkout #{base_branch}")
  fast_forward_base_branch
  run!("git push origin #{base_branch}")
  puts "Merged #{pull_request['url']}"
  delete_branch if switches.delete_branch?
end

main
